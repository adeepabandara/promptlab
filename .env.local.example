# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Anthropic (default for Claude models)
ANTHROPIC_API_KEY=your_anthropic_key

# OpenAI (default for GPT models)
OPENAI_API_KEY=your_openai_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Blender render server (python/render_server.py)
# Local: brew install --cask blender && pip install flask && python python/render_server.py
# Cloud: deploy python/ to Render.com using render.yaml
PYTHON_RENDER_URL=http://localhost:7860
PYTHON_RENDER_SECRET=                         # optional bearer token (must match server RENDER_SECRET)
NEXT_PUBLIC_BLENDER_RENDER_ENABLED=1          # set to '1' to show Blender Render section in UI
